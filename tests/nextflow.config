/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/// nf-core: Specify any additional parameters here// Or any resources requirementsparams {
        modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
        pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/fastqrepair'
        qin = 33
        alphabet = "ACGTN"
}
// Impose sensible resource limits for testingprocess {
        resourceLimits = [
        cpus: 2,
        memory: '3.GB',
        time: '1.h',
    ]
}
aws.client.anonymous = true
